#!/usr/sbin/nft -f
# Managed by Ansible (baseline role): local edits are overwritten.
# Only this table is replaced: rules added by k3s and Cilium are untouched.

# Create it if missing, then delete it: makes the reload atomic
table inet node_firewall
delete table inet node_firewall

table inet node_firewall {
  # Every node in the inventory
  set cluster_nodes {
    type ipv4_addr
    elements = { {{ groups['all'] | map('extract', hostvars, 'public_ip') | join(', ') }} }
  }

  chain input {
    type filter hook input priority filter; policy drop;

    # Replies to connections the node opened, and connections already open
    ct state established,related accept
    ct state invalid drop

    # Local traffic, and pod traffic on the interfaces Cilium creates
    iifname "lo" accept
    iifname "cilium_*" accept
    iifname "lxc*" accept

    # From anywhere: SSH and ping
    tcp dport 22 accept
    ip protocol icmp accept

    # From the other nodes only: k3s and etcd (TCP), WireGuard (UDP)
    ip saddr @cluster_nodes ip protocol tcp accept
    ip saddr @cluster_nodes udp dport 51871 accept

    # Everything else is dropped; this counts it
    counter comment "dropped"
  }
}

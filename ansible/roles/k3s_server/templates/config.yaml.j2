# Managed by Ansible (k3s_server role): local edits are overwritten.

# ---------- This node ----------
node-name: {{ inventory_hostname }}
node-ip: {{ public_ip }}
tls-san:
  - {{ ansible_host }}

# ---------- Joining the cluster ----------
token: {{ k3s_server_token }}
{% if inventory_hostname == k3s_init_node %}
# This node created the cluster (only used on its very first start)
cluster-init: true
{% else %}
server: https://{{ hostvars[k3s_init_node].ansible_host }}:6443
{% endif %}

# ---------- Security ----------
# Secrets are encrypted inside etcd from the first start
secrets-encryption: true

# ---------- Replaced by Cilium and our own platform ----------
flannel-backend: none
disable-network-policy: true
disable-kube-proxy: true
disable:
  - traefik
  - servicelb
disable-helm-controller: true

# ---------- etcd snapshots: local and on R2 ----------
etcd-snapshot-schedule-cron: "{{ k3s_server_snapshot_schedule }}"
etcd-snapshot-retention: {{ k3s_server_snapshot_retention }}
etcd-s3: true
etcd-s3-endpoint: {{ etcd_s3_endpoint }}
etcd-s3-region: auto
etcd-s3-bucket: {{ etcd_s3_bucket }}
etcd-s3-folder: {{ inventory_hostname }}
etcd-s3-access-key: {{ k3s_server_s3_key_id }}
etcd-s3-secret-key: {{ k3s_server_s3_secret_key }}

# Managed by Ansible (k3s_server role): local edits are overwritten.

# ---------- This node ----------
node-name: {{ inventory_hostname }}
node-ip: {{ public_ip }}
tls-san:
  - {{ ansible_host }}

# ---------- Joining the cluster ----------
token: {{ k3s_server_token }}
{% if inventory_hostname == k3s_init_node %}
# This node created the cluster (only used on its very first start)
cluster-init: true
{% else %}
server: https://{{ hostvars[k3s_init_node].ansible_host }}:6443
{% endif %}

# ---------- Security ----------
# Secrets are encrypted inside etcd from the first start
secrets-encryption: true

# ---------- Replaced by Cilium and our own platform ----------
flannel-backend: none
disable-network-policy: true
disable-kube-proxy: true
disable:
  - traefik
  - servicelb
    # One copy only, not configurable: platform/networking/coredns replaces it
  - coredns
    # A HelmChart for k3s's Helm controller, turned off below: it would retry
    # every 17 s, forever. Gateway API's CRDs: platform/networking/traefik
  - gateway-api-crd
disable-helm-controller: true

# ---------- Memory kept for k3s and the system ----------
# k3s is one process (API server, etcd, kubelet: ~1.7 GB on waw1) that the
# scheduler never counted, so it filled waw1 until the node froze
# (2026-11-24). Pods now get only the rest, and the kubelet evicts pods
# while 256 Mi are still free. Setting eviction-hard replaces all its
# defaults: the disk ones are written again, as they were
kubelet-arg:
  - "kube-reserved=cpu=200m,memory=1536Mi"
  - "system-reserved=cpu=100m,memory=256Mi"
  - "eviction-hard=memory.available<256Mi,nodefs.available<10%,nodefs.inodesFree<5%,imagefs.available<15%"

# ---------- Metrics, scraped by VictoriaMetrics ----------
# etcd's own metrics on 2381 (plain HTTP). Reachable from the cluster only:
# the firewalls never accept this port from outside. The scheduler's and
# the controller manager's need nothing: k3s serves them with the API
# server's (one process, one set of metrics)
etcd-expose-metrics: true

# ---------- etcd snapshots: local and on R2 ----------
etcd-snapshot-schedule-cron: "{{ k3s_server_snapshot_schedule }}"
etcd-snapshot-retention: {{ k3s_server_snapshot_retention }}
etcd-snapshot-compress: true
etcd-s3: true
etcd-s3-endpoint: {{ etcd_s3_endpoint }}
etcd-s3-region: auto
etcd-s3-bucket: {{ etcd_s3_bucket }}
etcd-s3-folder: {{ inventory_hostname }}
etcd-s3-access-key: {{ k3s_server_s3_key_id }}
etcd-s3-secret-key: {{ k3s_server_s3_secret_key }}

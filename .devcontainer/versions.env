# Tool versions for the devcontainer: the single place to change them.
# Keep kubectl in line with the cluster's k3s version.
# The renovate comments let Renovate propose bumps (Phase 4).

# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.37.2
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.1
# renovate: datasource=github-releases depName=kubernetes-sigs/kustomize extractVersion=^kustomize/(?<version>.*)$
KUSTOMIZE_VERSION=v5.8.3
# renovate: datasource=github-releases depName=cilium/cilium-cli
CILIUM_CLI_VERSION=v0.20.2
# renovate: datasource=github-releases depName=k3d-io/k3d
K3D_VERSION=v5.9.0
# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION=v0.8.0
# renovate: datasource=github-releases depName=kyverno/kyverno
KYVERNO_VERSION=v1.19.2
# renovate: datasource=github-releases depName=bitwarden/sdk-sm extractVersion=^bws-v(?<version>.*)$
BWS_VERSION=2.1.0
# renovate: datasource=github-releases depName=cli/cli extractVersion=^v(?<version>.*)$
GH_VERSION=2.103.3
# renovate: datasource=pypi depName=ansible-core
ANSIBLE_CORE_VERSION=2.21.6
# renovate: datasource=pypi depName=ansible-lint
ANSIBLE_LINT_VERSION=26.11.0
# renovate: datasource=pypi depName=yamllint
YAMLLINT_VERSION=1.38.0
# renovate: datasource=pypi depName=passlib
PASSLIB_VERSION=1.7.4
